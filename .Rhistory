text <- "My favorite number is 123"
print(grepl("[A-Z]", text))     # Check for uppercase letters
print(grepl("[a-z]", text))     # Check for lowercase letters
print(grepl("[0-9]", text))     # Check for numbers
print(grepl("[!@#$%^&*]", text)) # Check for special characters
x <- function(a,b){
z <- a+b
return(cat("The value of z is", z))
}
x
x(2,3)
x <- function(a,b){
z <- a+b
return(cat("The value of z is", z))
}
x(2,3)
a <- x(2,3)
print(a)
